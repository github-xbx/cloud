<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xbx.study</groupId>
        <artifactId>cloud</artifactId>
        <version>1.0</version>
    </parent>

    <groupId>com.network</groupId>
    <artifactId>Network</artifactId>
    <packaging>pom</packaging>

    <properties>
        <version.reactor>2025.0.6</version.reactor>

    </properties>

    <modules>
        <module>reactor-netty</module>
        <module>mqtt</module>
        <module>starter</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 放在第一位，优先于其他可能引入旧版 Netty 的 BOM -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.15.Final</version> <!-- 与 Reactor Netty 1.3.6 对齐 -->
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Source: https://mvnrepository.com/artifact/io.projectreactor/reactor-bom -->
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-bom</artifactId>
                <version>${version.reactor}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>
        <finalName>Network</finalName>
    </build>
</project>
